{
  "name": "root",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "node": "20 || 22"
  },
  "scripts": {
    "start": "backstage-cli repo start ",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/master",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new",
    "use:local:frontend-plugin": "yarn workspace app add @citrixcloud/backstage-sds-workspaces@workspace:./plugins/sds-workspaces",
    "use:registry:frontend-plugin": "yarn workspace app add @citrixcloud/backstage-sds-workspaces@npm:^0.1.6",
    "use:local:backend-plugin": "yarn workspace backend add @citrixcloud/backstage-sds-workspaces-backend@workspace:./plugins/sds-workspaces-backend",
    "use:registry:backend-plugin": "yarn workspace backend add @citrixcloud/backstage-sds-workspaces-backend@npm:^0.1.6",
    "use:local-plugins": "yarn run use:local:frontend-plugin && yarn run use:local:backend-plugin",
    "use:registry-plugins": "yarn run use:registry:frontend-plugin && yarn run use:registry:backend-plugin"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "plugins/*"
    ]
  },
  "devDependencies": {
    "@backstage/cli": "^0.34.1",
    "@backstage/e2e-test-utils": "^0.1.1",
    "@playwright/test": "^1.55.0",
    "node-gyp": "^10.0.0",
    "prettier": "^2.3.2",
    "typescript": "~5.8.0"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.4.1",
  "dependencies": {
    "@backstage/frontend-plugin-api": "^0.12.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.2",
    "@mui/system": "^7.3.2"
  }
}
